# Commune - ported from funky-station (PR #1922)
cult-commune-window = Commune
cult-commune-info = Whisper into the veil and communicate with your fellow worshippers.
cult-commune-send = Send
cult-commune-message = Acolyte { $name } (as { $job }): { $message }

# Ritual chants, randomly combined into incantations.
cult-chant-1 = Nar'Sie!
cult-chant-2 = Geom'thra!
cult-chant-3 = Sas'so c'arta forbici!
cult-chant-4 = Ka'ra'ankh
cult-chant-5 = Setesh m'khet!
cult-chant-6 = Nefer ka ma'at
cult-chant-7 = Khepri suten ankh
cult-chant-8 = Ptah netjer!
cult-chant-9 = Sobek wesir
cult-chant-10 = Anpu sa'anh!
cult-chant-11 = Thoth heqa
cult-chant-12 = Bastet sekhem
cult-chant-13 = Heru neb!
cult-chant-14 = Ra hotep ankh
cult-chant-15 = Draw blood for Nar'Sie!
cult-chant-16 = Sekhem ba ka

# Study the veil - status report
cult-status-header = THE VEIL
cult-status-veil-strong = It holds. It has not yet been torn.
cult-status-cultists = Cultists: { $count }
cult-status-constructs = Constructs: { $count }
cult-status-leader = Her voice among us: { $name }
cult-status-leader-none = She has not yet chosen a voice among us.
cult-status-stage = Our power: { $stage }.
cult-status-next-eyes = { $amount } more { $amount ->
        [one] convert
       *[other] converts
    } and our eyes will burn red.
cult-status-next-pentagram = { $amount } more { $amount ->
        [one] convert
       *[other] converts
    } and the pentagram will mark us.
cult-status-next-none = Our strength has reached its peak. Nothing more is needed.
cult-status-offering = Nar'Sie demands the blood of [color=#d43a3a]{ $name }[/color].
cult-status-offering-dead = [color=#d43a3a]{ $name }[/color] lies dead. Offer the body upon a rune.
cult-status-offering-none = No offering has been marked yet.
cult-status-rending-header = The veil is thin at:
cult-status-rending-location = { $location }
cult-status-rending-emergency = The veil is thin everywhere. We may still tear it { $amount } more { $amount ->
        [one] time
       *[other] times
    }.
cult-status-rending-none = Nowhere. The veil holds firm.
