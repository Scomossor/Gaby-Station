# Tear the veil + blood rift - ported from funky-station (PR #630 / #1922)

# Tearing the veil
cult-veil-ritual-started = The chant has begun. { $required } of us must hold the runes until the veil gives.
cult-veil-ritual-already-in-progress = The chant is already underway elsewhere.
cult-veil-ritual-already-completed = The veil is already torn. Find the rift.
cult-veil-ritual-not-enough-cultists = Not enough of us stand upon the runes. { $current } of { $required }.
cult-veil-ritual-broken = The chant falters!
cult-veil-ritual-failed = The chant broke. Only { $current } of { $required } held the runes.
cult-veil-ritual-success = The veil is torn. Nar'Sie stirs. Wait for the rift to bleed through.
cult-veil-torn = REALITY IS BLEEDING. THE VEIL HAS BEEN TORN.

# The rift
cult-rift-spawned = The rift has opened { $location }. Gather upon its runes.

# Final summoning
cult-final-ritual-started = The final chant begins. Whoever speaks the long words will be taken.
cult-final-ritual-already = The final chant is already underway.
cult-final-ritual-not-enough = Not enough of us stand upon the runes. { $current } of { $required }.
cult-final-ritual-response = Nar'Sie!
cult-final-ritual-broken = The chant collapses!
cult-final-ritual-failed = The final chant broke. Only { $current } of { $required } held the runes.
cult-final-ritual-sacrifice = { $done ->
        [1] The first offering is taken. She begins to enter our reality.
        [2] The second offering is taken. The Geometer pries open the veil.
       *[other] The final offering is taken. She. Is. Here.
    }

# Study the veil, once it has been torn
cult-status-rift-pending = The veil is torn. The rift is still forcing its way through.
cult-status-rift-open = The rift bleeds { $location }. Stand upon its runes and chant.

# Leader vote
cult-leader-vote-title = Who shall speak for Nar'Sie?
cult-leader-vote-initiator = The Geometer of Blood
cult-leader-vote-started = Nar'Sie asks us to name the one who will speak for her.
cult-leader-chosen = [color=#d43a3a]{ $name }[/color] speaks for Nar'Sie now.
cult-leader-lost = Her voice among us has been silenced. She will ask again shortly.

# Rending requirements
cult-status-rending-locked = The veil cannot be torn yet:
cult-status-rending-need-cultists = { $amount } more of us must join. { $required } are needed in all.
cult-status-rending-need-offering = The marked offering has not been given upon a rune.
cult-status-rending-ready = The veil is ready to be torn.
cult-rending-unlocked = We are enough, and the offering is made. The veil can be torn now.

# Central Command's briefing when the veil goes
alert-level-deltacult-announcement = Attention all personnel: reality-distortion anomalies have been detected. The veil between dimensions has been compromised. All security personnel are to arm themselves immediately. Avoid, detain or stop any crewmember exhibiting extradimensional abilities. The station is now operating under Vatican protocols; follow the guidance of your nearest Chaplain.

# Central Command notices the countdown
cult-ascension-centcom-sender = Central Command
cult-ascension-centcom-announcement = Attention: our long-range sensors have picked up space-time disturbances originating from your station. The readings are consistent with an incipient dimensional breach. Security is advised to sweep the station and report anything anomalous. Do not panic.

# The rift's brood
ghost-role-information-hellspawn-cult-name = Hellspawn
ghost-role-information-hellspawn-cult-description = Crawl out of the blood rift and tear apart anyone who comes to close it.
ghost-role-information-hellspawn-cult-rules = You are a beast of Nar'Sie, dragged through the tear in reality. You are not a cultist and you take no orders, but the cult is not your prey - the crew is. Guard the rift. Kill anything that is not of the Geometer.

# Dumont
cult-status-offering-done = The offering has been made.
