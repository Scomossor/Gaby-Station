ent-BloodCultBarrier = barreira do culto
    .desc = Pode ser destruída com a adaga ritual.
ent-WallForceCult = parede brilhante
    .desc = Um escudo profano que bloqueia todos os ataques.
ent-CultFactoryAltar = altar
