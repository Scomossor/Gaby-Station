# NeuroAversion trait
trait-neuro-aversion-name = Neuroaversão 
trait-neuro-aversion-desc = Seu sistema nervoso tem uma reação adversa a implantes. Você experimenta enxaquecas e convulsões raras.

trait-neuro-aversion-migraine-start = Seu implante começa a pulsar dolorosamente...
trait-neuro-aversion-migraine-start-other = {THE($target)} faz careta e segura {POSS-ADJ($target)} cabeça.

seizure-prodrome-self = Você sente algo terrível chegando...
seizure-prodrome-others = {$target} tropeça e se contorce.
seizure-self = Seu corpo se contorce incontrolavelmente!
seizure-others = {$target} cai e se contorce incontrolavelmente!
seizure-end-self = Sua visão volta ao normal conforme o tempo passa.
seizure-end-others = As convulsões de {$target} diminuem.

# ChronicMigraines trait
trait-chronic-migraines-name = Enxaquecas Crônicas
trait-chronic-migraines-desc = Você experimenta ocasionamente enxaquecas debilitantes que prejudicam sua visão e movimento.

trait-chronic-migraines-start = Sua cabeça começa a pulsar dolorosamente...
trait-chronic-migraines-end = A enxaqueca passa.
trait-chronic-migraines-others = {THE($target)} esfrega {POSS-ADJ($target)} têmporas com dor.
