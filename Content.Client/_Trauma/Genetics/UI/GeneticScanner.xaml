<BoxContainer xmlns="https://spacestation14.io" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Content.Trauma.Client.Genetics.UI.GeneticScanner"
        xmlns:controls="using:Content.Client.UserInterface.Controls"
        Orientation="Vertical"
        Align="Center"
        VerticalExpand="True"
        HorizontalExpand="True">
    <controls:StripeBack>
        <Label Name="ErrorLabel" Text="{Loc 'genetics-console-no-scanner'}" HorizontalAlignment="Center" Margin="8"/>
    </controls:StripeBack>
    <Button Name="ScanButton" Text="{Loc 'genetics-console-scan'}" MaxWidth="80" Disabled="True"/>
</BoxContainer>
